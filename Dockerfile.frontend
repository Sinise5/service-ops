# Multi-stage build: build static + serve via nginx
FROM node:20-alpine AS builder

WORKDIR /app

# Copy the npm manifest and its matching lockfile.
COPY frontend/package.json frontend/package-lock.json ./

# Reproduce the dependency tree from package-lock.json.
RUN npm ci

# Copy source
COPY frontend/ ./

# Build
RUN npm run build

# Production stage
FROM nginx:1.25-alpine

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]
