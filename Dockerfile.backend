# Multi-stage build for Robyn backend (uv)
FROM python:3.12-slim AS builder

# Install system dependencies for psycopg
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.6 /uv /uvx /bin/

WORKDIR /app

# Copy dependency files
COPY backend/pyproject.toml backend/uv.lock* ./

# Install dependencies (production only)
RUN uv sync --frozen --no-dev

# Final stage
FROM python:3.12-slim

# Install runtime dependencies for psycopg + curl (healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy installed dependencies from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY backend/src ./src
COPY backend/run_server.py ./
COPY INTEGRATION_GUIDE.md MONITORING_GUIDE.md ALERT_RULES_GUIDE.md ./
COPY docs/DOCKER_MANAGEMENT_GUIDE.md ./DOCKER_MANAGEMENT_GUIDE.md
COPY docs/VULNERABILITY_FEED.md ./VULNERABILITY_FEED.md

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Set environment
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PORT=9080

# Health check (curl built-in, no extra deps)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:9080/health || exit 1

EXPOSE 9080

CMD ["python", "run_server.py"]
